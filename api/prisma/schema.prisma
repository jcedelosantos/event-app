generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un Tenant = un cliente (club/iglesia) instalado en esta misma app. Todo lo que un tenant crea
// (eventos, mapas, tickets, ventas, compradores...) queda acotado a su propio tenantId, así dos
// clientes comparten la misma base sin poder ver ni interferir con los datos del otro. La única
// cuenta sin tenant es el Super Admin (ver User.tenantId), que da de alta nuevos tenants.
model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  // URL del logo de la organización (mismo mecanismo que las imágenes de evento, ver
  // lib/uploads.ts) — se muestra en pantallas públicas de marca propia (ej. sala de espera
  // virtual, ver lib/waiting-room.ts). null = sin logo cargado, cae a un ícono genérico.
  logoUrl   String?
  // GENERAL | CLUB | CHURCH | ONG | PRIVADA | PUBLICA | INDEPENDIENTE — condiciona reglas de
  // negocio propias de cada tipo de organización. Por ahora solo CLUB tiene una: exigir carnet de
  // socio o del socio que invita al reservar un asiento (ver SaleTicket.attendeeType/sponsorCarnet
  // y la validación en sale-tickets.ts/public.ts). Los 4 tipos nuevos no tienen reglas propias
  // todavía — caen al comportamiento general, igual que cualquier tipo distinto de CLUB/CHURCH.
  type      String   @default("GENERAL")
  createdAt DateTime @default(now())

  // Datos fiscales/de contacto del cliente para el bloque "Para" de la factura (ver
  // lib/invoice-pdf.ts) — opcionales porque no todo tenant existente los tiene cargados todavía.
  rnc     String?
  address String?
  phone   String?

  // Comprobante de transferencia bancaria subido en el checkout de evento único (ver
  // routes/signup-event.ts) — solo se usa mientras planStatus === PENDING_REVIEW; queda guardado
  // después de aprobar/rechazar como historial de lo que el Super Admin revisó.
  paymentReceiptUrl String?

  // Espejo de Subscription.plan/status — el feature-gating (ver middleware/plan.ts) corre en casi
  // cada request y no conviene un join extra a Subscription; el webhook de PayPal Billing es quien
  // mantiene sincronizados estos dos campos con la fila real. plan null = tenant sin suscripción
  // propia todavía (ej. dado de alta a mano por Super Admin antes de que existiera este sistema, o
  // el tenant "seed" de desarrollo) — el feature-gating trata null como "sin restricción" para no
  // romper retroactivamente cuentas existentes.
  // BASICO | INTERMEDIO | AVANZADO | PRO_MAX (recurrente) — o, para un tenant "evento único, sin
  // suscripción" (ver lib/event-plans.ts), un código con prefijo EVENT_ (EVENT_100 | EVENT_300 |
  // EVENT_500 | EVENT_1000 | EVENT_2500 | EVENT_5000). Este último tipo paga una vez y no tiene
  // fila de Subscription — el prefijo es lo único que lo distingue de un tenant recurrente.
  plan       String?
  // ACTIVE | PAST_DUE | SUSPENDED | CANCELLED — null junto con plan null. EVENT_ENDED es propio
  // de un tenant de evento único (ver arriba): su evento ya pasó y quedó en modo de solo consulta
  // (requireActiveSubscription, ver middleware/plan.ts, ya trata cualquier valor que no sea ACTIVE
  // como "bloquear escrituras, permitir lecturas" — no necesita tratamiento especial). PENDING_REVIEW
  // es propio de un tenant de evento único que eligió pagar por transferencia (ver
  // routes/signup-event.ts): subió el comprobante, espera que un Super Admin lo confirme a mano —
  // mismo gate de solo-lectura que EVENT_ENDED, sale gratis por el mismo motivo. ARCHIVED es un paso
  // más allá de EVENT_ENDED (ver lib/event-plan-expiry.ts): a los 30 días en EVENT_ENDED sin que
  // nadie lo reactive, además de solo-lectura se bloquea el LOGIN (routes/auth.ts) — nada se borra,
  // los datos quedan intactos para auditoría o reactivación manual a mano desde Super Admin.
  planStatus String?
  subscription Subscription?

  users         User[]
  events        Event[]
  maps          Map[]
  areas         Area[]
  tables        Table[]
  seats         Seat[]
  tickets       Ticket[]
  products      Product[]
  saleTickets   SaleTicket[]
  saleProducts  SaleProduct[]
  auditLogs     AuditLog[]
  appSettings   AppSetting[]
  children      Child[]
  clubMembers   ClubMember[]
  accessPoints  AccessPoint[]
  scanConflicts ScanConflict[]
  serviceRequests ServiceRequest[]
  invoices      Invoice[]
}

// La mensualidad que el TENANT le paga a la agencia (no confundir con SaleTicket, que es la venta
// de UN ticket a UN asistente del club — acá el "comprador" es el club mismo, y el dinero va a la
// cuenta PayPal de la agencia, no a la del tenant). Un tenant tiene a lo sumo una fila acá — el
// historial de ciclos/renovaciones vive del lado de PayPal, no se duplica localmente en esta
// primera vuelta (ver plan de "Alta pública + suscripción").
model Subscription {
  id       Int    @id @default(autoincrement())
  tenantId Int    @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  plan   String // BASICO | INTERMEDIO | AVANZADO | PRO_MAX
  // PENDING | ACTIVE | PAST_DUE | SUSPENDED | CANCELLED | PENDING_REVIEW. PENDING_REVIEW es propio
  // de una suscripción que eligió pagar por transferencia (ver routes/signup.ts POST
  // /signup/submit-receipt): subió el comprobante, espera que un Super Admin lo confirme a mano —
  // mismo significado que Tenant.planStatus PENDING_REVIEW, se mantienen espejados.
  status String @default("PENDING")

  paypalSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  // Overage calculado (asistentes reales de un evento por encima del cupo del plan) todavía sin
  // cobrar — PayPal Subscriptions no permite cobrar un monto variable arriba de una suscripción
  // sin permisos de "Reference Transactions" (nivel partner). Se acumula acá y se factura aparte
  // hasta que eso se resuelva; ver middleware/plan.ts para el cálculo.
  pendingOverageUSD    Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auto-login de un solo uso tras el alta (ver routes/signup.ts POST /signup y GET
  // /signup/status/:tenantId) — el token en texto plano se manda una sola vez en la respuesta de
  // POST /signup (y viaja de vuelta embebido en el return_url de PayPal); acá solo se guarda su
  // hash SHA-256. Cuando el webhook activa la suscripción y el polling manda el token correcto, el
  // backend emite una sesión real y pone estos dos campos en null — así un token ya usado, robado
  // de logs o reintentado no puede generar una segunda sesión.
  claimTokenHash      String?
  claimTokenExpiresAt DateTime?
}

// Registro persistente de cada factura generada (ver lib/invoice-generation.ts) — antes de este
// modelo, la factura se armaba en memoria y se descartaba al enviarla, sin dejar ningún historial
// consultable. El PDF en sí NO se guarda en la fila (se re-escribe a uploadsDir, mismo mecanismo
// que logos/comprobantes) — pdfUrl apunta a ese archivo. Los montos quedan congelados al momento
// de emitir (no recalculados después), igual que una factura real: si el plan del tenant cambia
// más adelante, las facturas viejas no deben mostrar el precio nuevo.
model Invoice {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  invoiceNumber String // referencia interna (INV-<tenantId>-<yyyymm>) — siempre existe
  ncf           String? // comprobante fiscal de DGII — null si el Super Admin no configuró el rango al momento de emitir
  billingPeriod String // "2026-08", el mes que factura (no necesariamente el mes en que se generó)
  planCode      String?
  planPriceUSD  Float
  overageUSD    Float    @default(0)
  totalUSD      Float // planPriceUSD + overageUSD + ITBIS
  pdfUrl        String
  // MANUAL (Super Admin la generó a mano) | AUTO (cron mensual, ver lib/invoice-cron.ts)
  generatedBy   String
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

// Config de plataforma genuinamente global (sin tenantId) — hoy solo guarda el PayPal usado para
// cobrar la suscripción recurrente (ver lib/paypal-billing.ts). Es su propio lugar, no un lookup
// dinámico a ningún Tenant: se puebla una vez con `npm run copy:paypal-platform` (copiando, para
// arrancar, las credenciales de prueba que ya están cargadas en el tenant del club) y de ahí en
// más vive independiente — si el club cambia su propio PayPal de tickets más adelante, esto no se
// entera ni se rompe.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model UserType {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  type        String
  license     String // JSON-encoded string[] (SQLite has no native array type)
  users       User[]
}

model User {
  id        Int      @id @default(autoincrement())
  // username SÍ tiene que ser único en toda la app (no solo por tenant): el login resuelve a qué
  // tenant pertenece la cuenta a partir del username (ver auth.ts), antes de saber el tenantId —
  // dos organizaciones no pueden tener el mismo. El email, en cambio, es solo un dato de contacto
  // del comprador — la misma persona compra en varios clubes/iglesias con el mismo email, así que
  // va único por tenant (ver @@unique abajo), no global.
  username  String   @unique
  password  String // bcrypt hash
  name      String
  lastname  String
  gender    String
  email     String
  carnet    String
  adress    String
  phone     String
  typeId    Int
  type      UserType @relation(fields: [typeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Nullable SOLO para la cuenta de Super Admin, que opera fuera de todos los tenants (gestiona el
  // panel /tenants). Cualquier otro usuario (staff o comprador) siempre pertenece a un tenant.
  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  eventsCreated       Event[]       @relation("EventCreatedBy")
  salesAsSeller       SaleProduct[] @relation("SaleProductSeller")
  salesAsClient       SaleProduct[] @relation("SaleProductClient")
  ticketSalesAsSeller SaleTicket[]  @relation("SaleTicketSeller")
  ticketSalesAsClient SaleTicket[]  @relation("SaleTicketClient")
  auditLogs           AuditLog[]    @relation("AuditLogUser")
  childrenRegistered  Child[]       @relation("ChildParent")
  serviceRequestsMade ServiceRequest[]

  @@unique([tenantId, email])
}

// Registro de auditoría de acciones sensibles (alta/edición/borrado de Events, Products, Users,
// y borrado de ventas). userId es nullable y con SetNull para que el rastro sobreviva aunque el
// usuario que hizo la acción se borre después — perder el log sería peor que perder la referencia.
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE | UPDATE | DELETE
  entity    String // Event | Product | User | SaleTicket | SaleProduct
  entityId  Int
  summary   String
  createdAt DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Event {
  id          Int       @id @default(autoincrement())
  name        String
  img         String
  code        String    @unique
  type        String
  description String
  dateSale    DateTime
  dateOn      DateTime
  dateOff     DateTime
  startTime   String?
  active      Boolean   @default(true)
  // ACTIVE | CANCELLED | POSTPONED — distinto de `active` (que oculta el evento del todo, ej. un
  // borrador o un duplicado de prueba). Un evento CANCELLED/POSTPONED sigue siendo `active` y
  // sigue apareciendo en el portal público (ver public.ts), pero deshabilitado para compra y con
  // una etiqueta visible — el manager quiere que la gente SEPA que se canceló/pospuso, no que
  // desaparezca sin explicación.
  status      String    @default("ACTIVE")
  // Fecha/hora a partir de la cual el evento se vuelve visible/comprable en el portal público (ver
  // public.ts) — permite subir y configurar un evento con anticipación sin exponerlo todavía. null
  // (default para todo lo existente vía migración) = sin restricción, visible apenas se crea, igual
  // que el comportamiento de siempre. A propósito NO se reutiliza `dateSale` para esto: ya existe
  // hoy pero defaultea silenciosamente a `dateOn` para TODOS los eventos ya creados — usarlo como
  // gate rompería la visibilidad de cualquier evento vigente hasta el mismo día del evento.
  publishAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId    Int
  createdBy User @relation("EventCreatedBy", fields: [userId], references: [id])

  mapId Int?
  map   Map? @relation(fields: [mapId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Solo tiene sentido en tenants tipo CHURCH (ver Tenant.type) — el anfitrión de un evento (una
  // boda, quinceañero, etc. armado en el salón de la iglesia) puede invitar gente sin costo, hasta
  // este máximo (ver SaleTicket.isHostGuest y la validación en sale-tickets.ts). maxHostGuests sin
  // definir (null) significa que este evento no admite invitados de anfitrión.
  hostName      String?
  maxHostGuests Int?

  // Solo tiene sentido en tenants tipo CLUB (ver Tenant.type) — "misma función, distinta fecha"
  // (ej. un concierto repetido dos noches). Dos o más eventos que comparten este valor forman un
  // grupo: un socio/invitado que ya se registró en uno no puede volver a registrarse en otro del
  // mismo grupo (ver lib/duplicate-event-guard.ts). null significa que el evento no está vinculado
  // a ningún otro.
  duplicateGroupKey String?

  // NONE | PAYPAL | LINK | BOTH — si el portal público de ESTE evento exige pago online antes de
  // reservar el asiento, y con qué método(s). Las credenciales/URL reales viven en AppSetting (una
  // por tenant, ver "payments.*"), esto solo prende/apaga por evento (ver public.ts).
  paymentMode String @default("NONE")

  // Cuántas horas antes de startTime se habilita el check-in/entrega (scan.ts) — antes era un valor
  // fijo (1 hora) igual para todos los eventos, ahora configurable por si el club necesita abrir la
  // puerta más temprano (ej. eventos con acreditación) o más ajustado.
  checkInWindowHours Int @default(1)

  // Si está prendido, el picker público de este evento hace pasar a los visitantes por una fila
  // virtual (ver lib/waiting-room.ts) antes de cargar la query pesada de GET /events/:code — para
  // eventos de alta demanda donde publishAt dispara mucha gente al mismo tiempo. false por defecto
  // (opt-in, cero cambio de comportamiento para el resto de los eventos).
  waitingRoomEnabled   Boolean @default(false)
  // Cuántas personas se admiten a la vez cuando waitingRoomEnabled está prendido. null = usa el
  // default del código (DEFAULT_BATCH_SIZE, ver lib/waiting-room.ts).
  waitingRoomBatchSize Int?

  // Cupo total del evento, compartido entre TODOS los tipos de ticket (a diferencia de
  // Ticket.count, que es el stock de cada tipo por separado) — aplica a cualquier tenant. null =
  // sin tope (default, retrocompatible). Se valida sumando los SaleTicket del evento en vivo, no es
  // un contador que haya que mantener sincronizado (ver lib/capacity.ts).
  maxCapacity Int?

  // Solo tiene sentido en tenants tipo CLUB — cuántos invitados puede traer un socio a ESTE evento
  // (el socio + N invitados). null = usa el default del código (MAX_INVITADOS_PER_SOCIO, ver
  // lib/attendee.ts).
  maxGuestsPerSponsor Int?

  // Texto libre opcional que el manager carga por evento — se inserta en el email de confirmación
  // del ticket (ver lib/mail.ts sendTicketEmail), junto al resto de la info del evento. null = no
  // se agrega nada extra al email, comportamiento igual que antes de este campo.
  confirmationMessage String?

  // Link externo (Google Forms, Typeform, etc.) de la encuesta de satisfacción post-evento, opcional
  // por evento. Se manda en el email de confirmación apuntando a una página propia
  // (/encuesta/:code, ver routes/public.ts GET /survey/:code) que recién redirige acá una vez que
  // el evento terminó (dateOff) — el gate real vive en el servidor, no se puede controlar del lado
  // del email ya enviado. null = no se incluye ningún link.
  surveyUrl String?

  // Marca que el resumen post-evento de excedente (ver lib/overage-summary.ts, cron diario en
  // server.ts) ya se mandó para ESTE evento — null = todavía no se procesó. Se setea SIEMPRE que el
  // cron procesa un evento terminado, tenga o no overage, así el sweep diario no lo vuelve a mirar
  // (el overage de un evento ya terminado no cambia salvo ventas tardías, que este sistema no
  // contempla). Distinto de Subscription.claimTokenHash u otros "de un solo uso": esto no es un
  // secreto, es un flag de "ya procesado".
  overageSummarySentAt DateTime?

  tickets         Ticket[]
  products        Product[]
  saleProducts    SaleProduct[]
  saleTickets     SaleTicket[]
  children        Child[]
  accessPoints    AccessPoint[]
  serviceRequests ServiceRequest[]

  @@index([tenantId, duplicateGroupKey])
}

// Puerta física de entrada a un evento (Entrada Principal, VIP, Staff...) — puramente opt-in: un
// evento sin ninguna fila acá se comporta exactamente igual que antes de esta feature (scan.ts sin
// restricciones, dashboard sin panel de puertas). No se trackea hardware de scanner ni asignación
// persistente operador↔puerta — el operador elige la puerta desde su propio dispositivo al escanear
// (ver qr-scanner.component.ts), la elección se recuerda solo localmente (localStorage).
model AccessPoint {
  id        Int      @id @default(autoincrement())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  allowedTickets AccessPointTicket[]
  saleTickets    SaleTicket[]
  children       Child[]
  scanConflicts  ScanConflict[]

  @@index([tenantId])
  @@index([eventId])
}

// Allow-list de qué Ticket puede entrar por cada AccessPoint. Cero filas para una AccessPoint
// dada = sin restricción (deja pasar cualquier ticket) — decisión deliberada para que un club que
// se olvide de configurar una puerta no termine bloqueando gente el día del evento (ver scan.ts).
model AccessPointTicket {
  accessPointId Int
  accessPoint   AccessPoint @relation(fields: [accessPointId], references: [id], onDelete: Cascade)

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([accessPointId, ticketId])
}

model Map {
  id              Int      @id @default(autoincrement())
  name            String
  description     String
  img             String
  type            String
  x               Float
  y               Float
  radio           Float
  color           String
  size            Float
  backGround      String
  totalTables     Int      @default(0)
  totalTablesSeat Int      @default(0)
  totalSeats      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  areas  Area[]
  events Event[]

  @@index([tenantId])
}

model Area {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  img         String
  icon        String
  type        String
  x           Float
  y           Float
  radio       Float
  color       String
  size        Float
  backGround  String
  totalTables Int    @default(0)
  totalSeats  Int    @default(0)
  totalCount  Int    @default(0)

  mapId Int
  map   Map @relation(fields: [mapId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  seats   Seat[]
  tables  Table[]
  tickets Ticket[]

  @@index([tenantId])
}

model Table {
  id    Int    @id @default(autoincrement())
  name  String
  icon  String
  type  String
  x     Float
  y     Float
  radio Float
  color String
  size  Float

  areaId Int
  area   Area @relation(fields: [areaId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  seats Seat[]

  @@index([tenantId])
}

model Seat {
  id    Int    @id @default(autoincrement())
  name  String
  icon  String
  type  String
  x     Float
  y     Float
  radio Float
  color String
  size  Float

  areaId Int
  area   Area @relation(fields: [areaId], references: [id])

  tableId Int?
  table   Table? @relation(fields: [tableId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  saleTickets SaleTicket[]

  @@index([tenantId])
}

model Ticket {
  id          Int     @id @default(autoincrement())
  img         String
  code        String  @unique
  name        String
  description String
  type        String
  count       Int
  active      Boolean @default(true)
  price       Float

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])

  // Si se define, este tipo de ticket solo da acceso a asientos de esta área — el picker público
  // usa esto para no mostrarle al comprador áreas que su ticket no cubre (ej. tickets "General" vs
  // "VIP" ligados cada uno a su propia área). Sin asignar, el ticket sigue viendo todas las áreas
  // del mapa (comportamiento previo, retrocompatible).
  areaId Int?
  area   Area? @relation(fields: [areaId], references: [id])

  // Solo tiene sentido en tenants tipo CLUB (ver Tenant.type) — SOCIO | INVITADO | null. Marca a
  // qué tipo de comprador corresponde este ticket, para que el picker público lo auto-seleccione
  // según lo que la persona responda en "¿Sos socio o invitado?" (ver public-event.component.ts),
  // en vez de obligarla a elegir el ticket a mano.
  attendeeType String?

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  saleTickets  SaleTicket[]
  accessPoints AccessPointTicket[]

  @@index([tenantId])
}

model Product {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  img         String
  name        String
  description String
  type        String
  variant     String  @default("")
  count       Int
  active      Boolean @default(true)
  price       Float

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Solo tiene sentido en tenants tipo CHURCH — marca cuál producto de este evento es la comida del
  // día a repartir, para que al registrar un hijo (ver Child) se pueda ofrecer pedirla sin que el
  // manager tenga que acordarse cuál producto es cuál por nombre.
  isMealOfTheDay Boolean @default(false)

  saleProducts SaleProduct[]

  @@index([tenantId])
}

model SaleProduct {
  id          Int       @id @default(autoincrement())
  quantity    Int       @default(1)
  description String    @default("")
  dateSold    DateTime  @default(now())
  paidType    String
  codeQR      String    @unique
  deliveredAt DateTime?

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  userId Int
  seller User @relation("SaleProductSeller", fields: [userId], references: [id])

  clientId Int
  client   User @relation("SaleProductClient", fields: [clientId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Lado inverso de Child.saleProductId — presente solo si esta venta es la comida del día de un
  // hijo registrado (ver Child).
  child Child?

  @@index([tenantId])
}

model SaleTicket {
  id          Int       @id @default(autoincrement())
  status      Int       @default(1)
  active      Boolean   @default(true)
  description String
  dateSold    DateTime  @default(now())
  paidType    String
  codeQR      String    @unique
  checkedInAt DateTime?

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])

  seatId Int
  seat   Seat @relation(fields: [seatId], references: [id])

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  userId Int
  seller User @relation("SaleTicketSeller", fields: [userId], references: [id])

  clientId Int
  client   User @relation("SaleTicketClient", fields: [clientId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Solo tienen sentido en tenants tipo CLUB (ver Tenant.type) — SOCIO | INVITADO. Un invitado no
  // es socio del club: en vez de su propio carnet, se guarda el carnet del socio que lo invitó
  // (sponsorCarnet), y se limita a 2 invitados por socio por evento (validado en la ruta, no acá).
  attendeeType  String  @default("SOCIO")
  sponsorCarnet String?

  // Solo tiene sentido en tenants tipo CHURCH — esta venta es cortesía del anfitrión del evento
  // (ver Event.hostName/maxHostGuests), no se cobra y cuenta contra el tope de invitados del
  // anfitrión (validado en la ruta, no acá).
  isHostGuest Boolean @default(false)

  // MANUAL (default) = la vendió un staff desde el manager (create-qr-modal, bulk-import) — PUBLIC =
  // el comprador se autogestionó desde el portal público (/purchase o /checkout/hold, con o sin
  // pago). Para saber "por dónde entró" cada venta en el panel de QRs (columna Origen).
  channel String @default("MANUAL")

  // PAID (default) preserva el comportamiento de siempre para toda venta manual del manager
  // (create-qr-modal, bulk-import) y eventos sin cobro online — nada de esto cambia. PENDING es
  // exclusivo del checkout público con pago (ver Event.paymentMode / public.ts): el asiento ya
  // queda tomado (protegido por el @@unique de abajo) pero el email con el QR no sale hasta que
  // pasa a PAID, ya sea por webhook/capture de PayPal o a mano desde el panel de QRs (Opción "Link").
  paymentStatus    String    @default("PAID")
  // PAYPAL | LINK | null — método usado en el checkout con pago; null para ventas manuales/sin cobro.
  paymentProvider  String?
  paypalOrderId    String?
  // Solo seteado mientras paymentStatus = PENDING — vencido este momento, el próximo intento de
  // reservar ESE asiento borra la fila vieja antes de crear la nueva (ver public.ts), sin necesitar
  // un cron aparte.
  paymentExpiresAt DateTime?
  // Secreto random compartido por todos los SaleTicket de un mismo hold (ver POST /checkout/hold) —
  // sin esto, POST /checkout/paypal/order solo recibía los `holdIds` (ids autoincrementales, fáciles
  // de adivinar) y cualquiera podía crear una orden PayPal real contra la cuenta de OTRO comprador.
  // El frontend tiene que devolver este valor junto con los holdIds para poder avanzar el pago — solo
  // seteado mientras paymentStatus = PENDING, null en cualquier venta manual/sin cobro online.
  holdToken        String?

  // Qué puerta hizo el check-in (ver AccessPoint) — nullable porque la mayoría de los eventos no
  // configura puertas (feature opt-in) y porque una venta empieza sin check-in hecho todavía.
  // SetNull en vez de bloquear el borrado de la puerta: el historial de check-in ya hecho no se
  // pierde aunque después se borre esa AccessPoint.
  accessPointId Int?
  accessPoint   AccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  // Un mismo asiento no se puede vender dos veces para el mismo evento.
  @@unique([eventId, seatId])
  // Reportes/historial/auditoría por organización (ver routes/audit-logs.ts, reports del manager) —
  // sin esto, cualquier consulta que filtre solo por tenantId (sin eventId) escanea la tabla entera,
  // de TODOS los tenants juntos, cada vez que crece.
  @@index([tenantId])
}

// Hijo de un participante, registrado junto con su ticket — solo tiene sentido en tenants tipo
// CHURCH (guardería/clase de niños durante el servicio). El mismo codeQR se imprime/envía DOS
// veces (talón del padre + pulsera del niño): el staff compara visualmente que coincidan antes de
// entregarlo, y al escanearlo (ver scan.ts) queda marcado el retiro con el mismo anti-doble-retiro
// que ya usan los tickets.
model Child {
  id          Int       @id @default(autoincrement())
  name        String
  age         Int?
  // Ya NO es único: todos los hijos del mismo padre/madre para el mismo evento comparten el
  // mismo codeQR ("talón familiar") — un solo escaneo en la puerta de comida entrega la comida de
  // todos los hermanos a la vez, en vez de tener que escanear uno por uno (ver scan.ts).
  codeQR      String
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])

  parentId Int
  parent   User @relation("ChildParent", fields: [parentId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Si el padre pidió comida del día para este hijo, queda vinculada acá la venta de ese producto
  // (ver Product.isMealOfTheDay) — nullable porque no todos los hijos piden comida.
  saleProductId Int?         @unique
  saleProduct   SaleProduct? @relation(fields: [saleProductId], references: [id])

  // Qué puerta hizo el retiro (ver AccessPoint / SaleTicket.accessPointId, mismo criterio).
  accessPointId Int?
  accessPoint   AccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  @@index([codeQR])
  @@index([parentId, eventId])
  @@index([tenantId])
}

// Simulación local del sistema de membresía real del club (todavía no existe un API real que
// consultar) — un socio activo/inactivo por carnet, usado para autocompletar y validar sus datos
// en el picker público (ver lib/club-members.ts, único punto que hay que cambiar el día que haya
// un API real: esta tabla desaparece, la función pasa a hacer un fetch, y ni el endpoint público
// ni el frontend se enteran del cambio). NO reemplaza a `User` (el cliente real que compra y
// termina en SaleTicket) — es la fuente de verdad externa que confirma si ESE carnet corresponde
// a un socio vigente, antes de dejarlo comprar como tal.
model ClubMember {
  id       Int     @id @default(autoincrement())
  carnet   String
  name     String
  lastname String
  email    String
  phone    String
  active   Boolean @default(true)

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, carnet])
}

// Configuración general de la app (ej. color de acento) — key-value genérico en vez de una
// columna por setting, para no necesitar una migración cada vez que se agrega una opción nueva.
// PK compuesta (tenantId, key): cada cliente configura la suya propia sin pisar la de otro.
model AppSetting {
  key   String
  value String

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
}

// Registro de un check-in/entrega que "perdió" la reconciliación offline (ver POST /scan/sync) —
// dos scanners sin señal pueden aprobar el mismo QR antes de poder sincronizar; el servidor no
// puede evitarlo (sin red entre ellos no hay forma de coordinarse), así que en vez de fallar en
// silencio deja este rastro para que el staff lo revise después del evento. No dispara ninguna
// acción automática sobre la venta — la persona ya entró físicamente en el momento del escaneo.
model ScanConflict {
  id          Int       @id @default(autoincrement())
  // SaleTicket | SaleProduct | Child — qué tabla es entityId, mismo criterio que AuditLog.entity.
  entityType  String
  entityId    Int
  codeQR      String
  // La hora REAL del escaneo perdedor (la que mandó el dispositivo, no la de sincronización) —
  // sirve para reconstruir qué pasó, ej. "el de las 20:03 le ganó al de las 20:05".
  attemptedAt DateTime
  createdAt   DateTime  @default(now())
  // El staff lo marca como revisado desde el panel de conflictos — no borra la fila, solo la
  // saca de la lista de pendientes (ver PUT /scan/conflicts/:id/resolve).
  resolvedAt  DateTime?

  accessPointId Int?
  accessPoint   AccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Solicitud de un tenant por un servicio adicional pago (renta de equipos, personal presencial,
// conectividad, etc. — ver lib/addon-services.ts, el catálogo real vive en código, no acá) — es
// el CANAL de la solicitud, no un checkout: se cotiza y factura a mano por el Super Admin, mismo
// criterio que el overage y las suscripciones hoy. status como String (no enum nativo de Prisma)
// por consistencia con el resto del schema (ver Subscription.status/SaleTicket.paymentStatus).
model ServiceRequest {
  id          Int       @id @default(autoincrement())
  status      String    @default("PENDING") // PENDING | QUOTED | FULFILLED | REJECTED
  // Código del paquete sugerido si la solicitud partió de uno (ver lib/addon-services.ts,
  // AddOnPackageCode) — null si el tenant armó la combinación de ítems a mano.
  packageCode String?
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolutionNote String?

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  requestedByUserId Int
  requestedBy       User @relation(fields: [requestedByUserId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  items ServiceRequestItem[]

  @@index([tenantId])
}

// Una línea de una ServiceRequest — una solicitud real casi siempre combina varios servicios del
// catálogo (ej. 4 scanners + 2 técnicos), nunca uno solo. nameSnapshot/unitPriceDOPSnapshot
// congelan el nombre/precio del catálogo AL MOMENTO de la solicitud, para que un cambio de precio
// después no reescriba silenciosamente el historial de lo que el tenant pidió.
model ServiceRequestItem {
  id               Int    @id @default(autoincrement())
  catalogCode      String
  nameSnapshot     String
  quantity         Int    @default(1)
  unitPriceDOPSnapshot Int?

  serviceRequestId Int
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

// Contacto de un prospecto para el plan Pro Enterprise (ver PLANS.PRO_MAX en lib/plans.ts) — ese
// plan no tiene alta autoservicio, así que esto es el único canal de entrada: el formulario público
// en site-web.component.ts lo crea, un Super Admin lo revisa/contacta a mano desde su panel y da de
// alta el tenant vía el flujo normal de tenants.ts una vez que cierran el acuerdo. Sin tenantId a
// propósito: el prospecto todavía no es cliente.
model EnterpriseLead {
  id          Int       @id @default(autoincrement())
  orgName     String
  contactName String
  email       String
  phone       String    @default("")
  message     String    @default("")
  createdAt   DateTime  @default(now())
  contactedAt DateTime?
}
