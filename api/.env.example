# Postgres desde la migración de Fase 2 (SQLite quedó atrás) — necesitás una instancia real corriendo
# (local o `railway run`/`railway ssh` contra la de Railway, ver lib/serializable-tx.ts para por qué
# Postgres importa acá). Formato estándar: postgresql://usuario:password@host:5432/nombre_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seat_app"
JWT_SECRET="change-me"
PORT=3001
# Opt-in explícito para que prisma/seed.ts cree el tenant/usuarios demo (admin, User, superadmin,
# todos con password "1234") en un arranque local recién clonado. Dejar SIN setear en cualquier
# ambiente de Railway (producción, load-test, etc.) — el Dockerfile corre este script en cada
# arranque de contenedor, así que esta variable es lo único que evita crear un SUPERADMIN real con
# password trivial si algún día ese contenedor arranca contra una DB nueva y vacía.
SEED_DEMO_DATA="true"
# Origen del frontend, usado para armar los return_url/cancel_url de PayPal Billing (ver
# routes/signup.ts) — nunca se toma de un valor mandado por el cliente, evita open-redirect. 4200 es
# el puerto default de `ng serve` (ver package.json), no 4201.
FRONTEND_URL="http://localhost:4200"

# Correo transaccional (tickets, facturas, avisos — ver lib/mail.ts). Sin esto, el envío de correos
# falla silenciosamente en desarrollo (best-effort en casi todos los call sites) — no bloquea el
# resto del flujo, pero no vas a poder probar el email real.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Buzón interno que recibe copias de avisos operativos (comprobantes de transferencia pendientes,
# resumen de overage post-evento, etc. — ver overage-summary.ts, signup.ts, signup-event.ts).
SUPER_ADMIN_NOTIFICATION_EMAIL=""

# Carpeta donde se guardan uploads (logos, comprobantes, PDFs de factura — ver lib/uploads.ts). En
# producción apunta al volumen persistente de Railway (/data/uploads); en local, cualquier carpeta
# sirve, se crea sola si no existe.
UPLOADS_DIR="./uploads"

# Alta de evento por foto/descripción con IA (ver lib/event-extraction.ts) — opcional: sin esto, esa
# función puntual del wizard de eventos queda deshabilitada, el resto de la app funciona igual.
ANTHROPIC_API_KEY=""

# Suscripción recurrente de la mensualidad (tenant -> agencia, ver lib/paypal-billing.ts) — el
# client_id/secret/mode NO se cargan acá: viven en la tabla PlatformSetting (su propio lugar,
# genuinamente global), poblada corriendo `npm run copy:paypal-platform` (copia, una sola vez, el
# PayPal que ya está configurado en un tenant de prueba en Settings -> Pagos).
#
# Webhook ID del recurso de Webhook de PayPal creado para /public/webhooks/paypal-billing — es un
# recurso propio, no hay nada que copiar (se crea a mano una vez en el panel de PayPal).
PAYPAL_PLATFORM_WEBHOOK_ID=""
# Cargar después de correr, en este orden: `copy:paypal-platform` y luego `setup:paypal-plans`.
PAYPAL_PLAN_ID_BASICO=""
PAYPAL_PLAN_ID_INTERMEDIO=""
PAYPAL_PLAN_ID_AVANZADO=""
PAYPAL_PLAN_ID_PRO_MAX=""
